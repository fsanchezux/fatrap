# Database URL for PostgreSQL
# For local development: postgresql://user:password@localhost:5432/fatrap_explorer
# For Vercel Postgres: Get this from your Vercel dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/fatrap_explorer"

# Admin login for the experimental index2.html drops editor
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_SECRET="a-long-random-string-min-32-chars"
